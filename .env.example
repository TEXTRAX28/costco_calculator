# Copy to .env.local and fill in the server-side settings.
# OPEN_AI_KEY is accepted as an alias for OPENAI_API_KEY.
OPENAI_API_KEY=

# A stable local allowance ID of 8-80 letters, digits, underscores or hyphens.
# Set a limit between 1 and 100. Zero keeps the scan button unavailable.
OPENAI_ALLOWANCE_ID=
OPENAI_REQUEST_LIMIT=0
# Defaults to this checkout's .receipt-reader-state/openai directory.
OPENAI_ALLOWANCE_DIRECTORY=

# Account setup is optional. Follow docs/AUTHENTICATION.md before enabling.
GATHER_AUTH_ENABLED=0
GATHER_AUTH_ORIGIN=
GATHER_AUTH_TRUST_PROXY=0
GATHER_AUTH_DATABASE_URL=
GATHER_AUTH_DATABASE_CA_FILE=
GATHER_AUTH_RATE_KEY=
GATHER_AUTH_IDLE_MINUTES=30
GATHER_AUTH_MAX_MINUTES=10080
GATHER_BETA_ALLOWED_EMAIL=
# An optional local list of compromised passwords, one exact entry per line.
GATHER_AUTH_PASSWORD_BLOCKLIST_FILE=

# Firebase manages password credentials and sends verification/reset emails.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
GATHER_FIREBASE_CREDENTIAL_FILE=

# Optional Google Web application OAuth credentials. Both values are required.
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
